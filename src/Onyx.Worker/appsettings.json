{
  "Site": {
    "PublicBaseUrl": "",
    "AllowIndexing": false
  },
  "IndexNow": {
    "Key": "",
    "Endpoint": "https://api.indexnow.org/indexnow",
    "TimeoutSeconds": 15
  },
  "Seo": {
    "OrganizationStructuredDataEnabled": false
  },
  "Media": {
    "StorageRoot": ""
  },
  "IdentitySecurity": {
    "AdminPortalBaseUrl": ""
  },
  "Leads": {
    "ConsentVersion": "1",
    "DefaultRecipients": [],
    "RecipientsByType": {},
    "ManageLinkHoursAfterSlot": 24
  },
  "ConnectionStrings": {
    "Onyx": ""
  },
  "Worker": {
    "HealthUrls": "http://127.0.0.1:5290",
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 120,
    "OutboxBatchSize": 50,
    "EmailBatchSize": 20,
    "MaxOutboxAttempts": 10,
    "MaxEmailAttempts": 8,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelayMinutes": 60,
    "ProcessedOutboxRetentionDays": 14,
    "JobRunRetentionDays": 30
  },
  "Email": {
    "Transport": "None",
    "FromAddress": "",
    "FromName": "Onyx Vanguard Solutions",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "TimeoutSeconds": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
