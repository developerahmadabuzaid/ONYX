<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Health checks, options and (later) Identity come from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MailKit" />
    <!-- Pins MimeKit's transitive System.Security.Cryptography.Pkcs to the patched version (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Feed parsing for the News Hub (owner-approved, Stage 11); used only by News.SyndicationNewsFeedReader. -->
    <PackageReference Include="System.ServiceModel.Syndication" />
    <!-- GA4 Data API and Search Console (owner-approved, Stage 12); used only by the Analytics adapters. -->
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.AnalyticsData.v1beta" />
    <PackageReference Include="Google.Apis.SearchConsole.v1" />
    <!-- Pin EF Core to the latest patched version (Npgsql depends on an older minimum). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Unit tests for internal adapters (image sanitization, IndexNow) live in the integration test project. -->
    <InternalsVisibleTo Include="Onyx.API.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Onyx.Application\Onyx.Application.csproj" />
    <ProjectReference Include="..\Onyx.Domain\Onyx.Domain.csproj" />
  </ItemGroup>
</Project>
