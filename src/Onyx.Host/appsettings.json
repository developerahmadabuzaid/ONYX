{
  "Site": {
    "PublicBaseUrl": "",
    "AllowIndexing": false
  },
  "IndexNow": {
    "Key": "",
    "Endpoint": "https://api.indexnow.org/indexnow",
    "TimeoutSeconds": 15
  },
  "Seo": {
    "OrganizationStructuredDataEnabled": false
  },
  "ConnectionStrings": {
    "Onyx": ""
  },
  "AllowedHosts": "localhost",
  "ApiSecurity": {
    "MaxRequestBodySizeBytes": 1048576,
    "HstsMaxAgeDays": 365
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Strict": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Search": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Jwt": {
    "Issuer": "onyx-api",
    "Audience": "onyx-web",
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "Sessions": {
    "IdleTimeoutMinutes": 60,
    "AbsoluteLifetimeHours": 12,
    "RefreshGraceSeconds": 30,
    "MaxGraceRedemptions": 3,
    "TwoFactorChallengeMinutes": 5,
    "EnrollmentChallengeMinutes": 15,
    "MaxChallengeAttempts": 5,
    "ValidationCacheSeconds": 15,
    "PermissionCacheSeconds": 60
  },
  "Leads": {
    "ConsentVersion": "1",
    "DefaultRecipients": [],
    "RecipientsByType": {},
    "ManageLinkHoursAfterSlot": 24
  },
  "Turnstile": {
    "SecretKey": "",
    "AllowedHostnames": [],
    "VerifyEndpoint": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "TimeoutSeconds": 10,
    "MaxTokenAgeSeconds": 300,
    "SiteKey": ""
  },
  "Content": {
    "PreviewTokenMinutes": 30,
    "SchedulerBatchSize": 50
  },
  "Media": {
    "StorageRoot": "",
    "MaxUploadBytes": 10485760,
    "MaxWidth": 8000,
    "MaxHeight": 8000,
    "MaxPixels": 40000000,
    "MaxFrames": 1000
  },
  "CustomerAccounts": {
    "TermsVersion": "1",
    "VerificationLifetimeHours": 48,
    "PasswordResetLifetimeMinutes": 60,
    "SessionIdleDays": 7,
    "SessionAbsoluteDays": 30,
    "MaxFailedSignIns": 5,
    "LockoutMinutes": 15
  },
  "AiDemo": {
    "Enabled": false,
    "PerCustomerDailyLimit": 10,
    "GlobalDailyLimit": 500,
    "MaxOutputTokens": 600
  },
  "IdentitySecurity": {
    "RequireTwoFactorForAllUsers": false,
    "AdminPortalBaseUrl": "",
    "InvitationLifetimeHours": 72,
    "PasswordResetLifetimeMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "OnyxApi": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  },
  "Consent": {
    "PolicyVersion": "1",
    "CookieLifetimeDays": 180
  },
  "DataProtection": {
    "KeysDirectory": ""
  },
  "Localization": {
    "DefaultLanguage": "ar",
    "Languages": [
      {
        "Code": "ar",
        "Direction": "rtl",
        "NativeName": "العربية"
      },
      {
        "Code": "en",
        "Direction": "ltr",
        "NativeName": "English"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Worker": {
    "HealthUrls": "http://127.0.0.1:5290",
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 120,
    "OutboxBatchSize": 50,
    "EmailBatchSize": 20,
    "MaxOutboxAttempts": 10,
    "MaxEmailAttempts": 8,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelayMinutes": 60,
    "ProcessedOutboxRetentionDays": 14,
    "JobRunRetentionDays": 30
  },
  "Email": {
    "Transport": "None",
    "FromAddress": "",
    "FromName": "Onyx Vanguard Solutions",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "TimeoutSeconds": 30
    }
  },
  "Host": {
    "RunWorker": false
  }
}