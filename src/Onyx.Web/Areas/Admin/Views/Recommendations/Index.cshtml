@using Onyx.Contracts.Common
@using Onyx.Contracts.Intelligence
@using Onyx.Web.Areas.Admin.Cms
@model PagedResult<RecommendationResponse>
@{
    Layout = "_AdminLayout";
    ViewData["TitleKey"] = "Nav.Recommendations";
    var status = ViewData["Status"] as string;
}
<h1>@T["Nav.Recommendations"]</h1>
<partial name="_CmsMessages" />
<p class="hint">@T["Cms.Recommendation.Hint"]</p>
<form method="get" asp-action="Index">
    <label>@T["Cms.Status"]
        <select name="status">
            <option value="">—</option>
            @foreach (var option in CmsOptions.RecommendationStatuses)
            {
                <option value="@option" selected="@(status == option)">@option</option>
            }
        </select>
    </label>
    <button type="submit">@T["Cms.Filter"]</button>
</form>
@foreach (var recommendation in Model.Items)
{
    <section>
        <h2>@recommendation.Title</h2>
        <p class="hint" dir="ltr">@recommendation.Kind · @recommendation.Status · @recommendation.Origin · @recommendation.Basis · @recommendation.LanguageCode</p>
        @if (recommendation.ContentItemId is { } contentId)
        {
            <p><a asp-controller="Content" asp-action="Overview" asp-route-id="@contentId">@T["Cms.Recommendation.Content"]</a></p>
        }
        <p><strong>@T["Cms.Recommendation.Issue"]:</strong> @recommendation.DetectedIssue</p>
        @if (!string.IsNullOrEmpty(recommendation.Reasoning))
        {
            <p><strong>@T["Cms.Recommendation.Reasoning"]:</strong> @recommendation.Reasoning</p>
        }
        <ul>
            @foreach (var change in recommendation.ProposedChanges)
            {
                <li><span dir="ltr">@change.Field</span>: <span dir="auto">@change.CurrentValue</span> → <span dir="auto">@change.ProposedValue</span></li>
            }
        </ul>
        <partial name="_Evidence" model="recommendation.Evidence" />
        @foreach (var observation in recommendation.Observations)
        {
            <p class="hint"><span dir="ltr">@observation.Kind · @observation.Assessment</span> @observation.Note</p>
        }
        @if (!string.IsNullOrEmpty(recommendation.DecisionNote))
        {
            <p>@T["Cms.Note"]: @recommendation.DecisionNote</p>
        }
        <form method="post" asp-action="Decide" asp-route-id="@recommendation.Id">
            <input type="hidden" name="version" value="@recommendation.Version">
            <label>@T["Cms.Note"] <input name="note" maxlength="1000"></label>
            @foreach (var operation in new[] { "approve", "reject", "apply", "mark-applied" })
            {
                <button type="submit" name="operation" value="@operation">@T["Cms.Recommendation." + operation]</button>
            }
        </form>
    </section>
}
@if (Model.TotalPages > 1)
{
    <nav class="pager" dir="ltr">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@status">@(Model.Page - 1)</a>
        }
        <span>@Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@status">@(Model.Page + 1)</a>
        }
    </nav>
}
<h2>@T["Cms.Recommendation.Propose"]</h2>
<form method="post" asp-action="Propose">
    <label>@T["Cms.Type"]
        <select name="kind">
            @foreach (var kind in CmsOptions.RecommendationKinds)
            {
                <option value="@kind">@kind</option>
            }
        </select>
    </label>
    <label>@T["Cms.Title"] <input name="title" required maxlength="200"></label>
    <label>@T["Cms.Recommendation.Issue"] <textarea name="detectedIssue" rows="2" required maxlength="2000"></textarea></label>
    <label>@T["Cms.Recommendation.Reasoning"] <textarea name="reasoning" rows="3" maxlength="4000"></textarea></label>
    <label>@T["Cms.Recommendation.Content"] <input name="contentItemId" dir="ltr"></label>
    <label>@T["Cms.Language"]
        <select name="languageCode">
            <option value="">—</option>
            @foreach (var language in CmsOptions.Languages)
            {
                <option value="@language">@language</option>
            }
        </select>
    </label>
    <label>@T["Nav.Clusters"] <input name="clusterId" dir="ltr"></label>
    <fieldset>
        <legend>@T["Cms.Recommendation.Change"]</legend>
        <label>@T["Cms.Revision.Field"] <input name="field" dir="ltr" placeholder="metaTitle"></label>
        <label>@T["Cms.Revision.Before"] <input name="currentValue"></label>
        <label>@T["Cms.Revision.After"] <input name="proposedValue"></label>
    </fieldset>
    <button type="submit">@T["Cms.Create"]</button>
</form>
