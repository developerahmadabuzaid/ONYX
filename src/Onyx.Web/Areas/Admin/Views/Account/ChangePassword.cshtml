@model ChangePasswordModel
@{
    Layout = "_AdminLayout";
    ViewData["TitleKey"] = "Nav.ChangePassword";
}
<h1>@T["Nav.ChangePassword"]</h1>
<partial name="_ValidationSummary" />
<form method="post" asp-action="ChangePassword">
    <label asp-for="CurrentPassword">@T["Field.CurrentPassword"]</label>
    <input asp-for="CurrentPassword" autocomplete="current-password" dir="ltr">
    <label asp-for="NewPassword">@T["Field.NewPassword"]</label>
    <input asp-for="NewPassword" autocomplete="new-password" dir="ltr" aria-describedby="password-hint">
    <p id="password-hint" class="hint">@T["Password.Hint"]</p>
    <label asp-for="ConfirmPassword">@T["Field.ConfirmPassword"]</label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" dir="ltr">
    <button type="submit">@T["ChangePassword.Submit"]</button>
</form>
