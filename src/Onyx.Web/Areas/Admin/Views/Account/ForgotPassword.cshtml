@model ForgotPasswordModel
@{ ViewData["TitleKey"] = "Forgot.Title"; }
<h1>@T["Forgot.Title"]</h1>
<p>@T["Forgot.Intro"]</p>
<partial name="_ValidationSummary" />
<form method="post" asp-action="ForgotPassword">
    <label asp-for="Email">@T["Field.Email"]</label>
    <input asp-for="Email" autocomplete="username" dir="ltr">
    <button type="submit">@T["Forgot.Submit"]</button>
</form>
