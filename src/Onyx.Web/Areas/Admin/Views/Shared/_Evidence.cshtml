@model IReadOnlyList<Onyx.Contracts.Intelligence.EvidenceDto>
@* Evidence always names its source; metrics appear only when a connected provider supplied them, with their period. *@
@if (Model.Count > 0)
{
    <ul class="hint">
        @foreach (var evidence in Model)
        {
            <li>
                <span dir="ltr">[@evidence.Source]</span> @evidence.Description
                @if (evidence.PeriodStartUtc is not null)
                {
                    <span><partial name="_Utc" model="evidence.PeriodStartUtc" /> – <partial name="_Utc" model="evidence.PeriodEndUtc" /></span>
                }
                @if (evidence.Metrics is { Count: > 0 } metrics)
                {
                    <span dir="ltr">@string.Join(", ", metrics.Select(metric => $"{metric.Key}: {metric.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"))</span>
                }
            </li>
        }
    </ul>
}
