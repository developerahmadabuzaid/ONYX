{
  "AllowedHosts": "localhost",
  "OnyxApi": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  },
  "Site": {
    "PublicBaseUrl": "",
    "AllowIndexing": false
  },
  "Consent": {
    "PolicyVersion": "1",
    "CookieLifetimeDays": 180
  },
  "Turnstile": {
    "SiteKey": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysDirectory": ""
  },
  "Localization": {
    "DefaultLanguage": "ar",
    "Languages": [
      { "Code": "ar", "Direction": "rtl", "NativeName": "العربية" },
      { "Code": "en", "Direction": "ltr", "NativeName": "English" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
