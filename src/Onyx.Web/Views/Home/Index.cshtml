@using System.Globalization
@using Onyx.Web.Content
@using Onyx.Web.Content.SiteContent
@model Onyx.Web.Content.HomePageModel
@inject LocalizedRouteTable Routes
@inject Onyx.Web.Content.SitePages.SitePageCatalog SitePages
@inject SiteCopy Copy
@{
    ViewData["PageClass"] = "home";
    ViewData["Nav"] = "home";
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var links = SiteLinks.For(Routes, SitePages, lang);
    // Editable copy (Admin → Homepage) falls back to the resource files; see SiteCopyCatalog for the editable keys.
    string[] Items(string key) => Copy[key].Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // The primary service categories (owner-confirmed), in this order, each linking to its dedicated service page.
    // AI Agent Engineering and AaaS are the headline offerings (Stage 2); AI & Automation remains the umbrella for RAG, automation and integration work.
    var services = new (string Key, string Icon, string? Path)[]
    {
        ("Agents", "agents", links.Page("services.ai-agents")),
        ("AaaS", "agents", links.Page("services.ai-as-service")),
        ("Ai", "ai", links.Page("services.ai")),
        ("Software", "software", links.Page("services.software")),
        ("Cloud", "cloud", links.Page("services.cloud")),
        ("Security", "shield", links.Page("services.security")),
    };
    var heroPoints = new[] { ("Point1", "integrated"), ("Point2", "software"), ("Point3", "infinity") };
    var why = new[] { ("Partnership", "link"), ("Expertise", "expertise"), ("Outcomes", "target"), ("Scalable", "growth") };
    // Technologies supplied in the owner's brief; to be confirmed against delivered capability before production (CLAUDE.md §2.1).
    var stack = new[] { "Cloud", "Software", "Data", "Ai" };
    var security = new[] { ("Architecture", "lock"), ("Access", "key"), ("Data", "data"), ("Monitoring", "monitor"), ("Backup", "backup"), ("Deployment", "deploy") };
    var whyImage = Copy.ImagePath(Copy.HomeSettings.WhyImageMediaId);
    var workRendered = false;
}

@* A. Hero ------------------------------------------------------------------------------------------------------------------ *@
@* The short-lived video reel is gone (owner decision 2026-10-14). The hero is a light CSS/SVG agents-network
   scene again: it loops in a few seconds, costs no video bytes, carries the frame on slow devices through
   the shared poster, and degrades to a still image under reduced motion. *@
<section class="hero" aria-labelledby="hero-title">
    @* Decorative colour only: blurred-soft radial fields behind the copy, hidden from assistive tech and
       skipped entirely when the visitor prefers reduced motion. *@
    <div class="hero__blobs" aria-hidden="true">
        <span class="blob blob--teal hero__blob hero__blob--a"></span>
        <span class="blob blob--sky hero__blob hero__blob--b"></span>
        <span class="blob blob--sun hero__blob hero__blob--c"></span>
        <span class="blob blob--coral hero__blob hero__blob--d"></span>
        <span class="blob blob--lilac hero__blob hero__blob--e"></span>
    </div>
    <div class="container hero__grid">
        <div class="hero__copy">
            <p class="label">@Copy["Home.Hero.Eyebrow"]</p>
            <h1 id="hero-title" class="display hero__title">
                <span class="hero__line text-gradient">@Copy["Home.Hero.Line1"]</span>
                @if (!string.IsNullOrWhiteSpace(Copy["Home.Hero.Line2"]))
                {
                    <span class="hero__line">@Copy["Home.Hero.Line2"]</span>
                }
            </h1>
            <p class="lead hero__lead">@Copy["Home.Hero.Lead"]</p>
            <div class="hero__actions">
                <a class="button button--primary button--arrow" href="#services"><span>@Copy["Home.Hero.Explore"]</span></a>
                @if (links.Contact is not null)
                {
                    <a class="button button--secondary" href="@links.Contact"><span>@Copy["Home.Hero.Discuss"]</span></a>
                }
            </div>
        </div>
        <div class="hero__stage" aria-hidden="true">
            @* Signature visual: an original illustration of the offering — AI agents, digital
               transformation and business solutions around a business dashboard (inline SVG + CSS).
               Decorative. The agents command centre lives in the AaaS section (_AaaSEcosystem). *@
            <partial name="_TransformationVisual" />
            <p class="hero__side">@Html.Raw(Copy["Home.Hero.Side"].ToString().Replace("\n", "<br>"))</p>
        </div>
    </div>
    <div class="container">
        <ul class="hero__points" role="list" aria-label="@Copy["Home.Hero.PointsLabel"]">
            @foreach (var (key, icon) in heroPoints)
            {
                <li class="hero__point"><partial name="_Icon" model="icon" /><span>@Copy[$"Home.Hero.{key}"]</span></li>
            }
        </ul>
    </div>
</section>

@* C. Services + technology news agent ----------------------------------------------------------------------------------------- *@
@* Two parts side by side (stacked on narrow screens): the services in a plain, scannable list, and the
   monitoring agent's feed of the latest technology news from the News Hub. The feed shows only real,
   published items with their attribution; with none yet, it says so instead of showing anything made up. *@
<section id="services" class="section services" aria-labelledby="services-title">
    <div class="container services__split">
        <div class="services__part">
            <header class="services__head" data-reveal>
                <p class="label">@Copy["Home.Services.Eyebrow"]</p>
                <h2 id="services-title" class="heading-xl">@Copy["Home.Services.Title"]</h2>
                <p class="section-head__lead">@Copy["Home.Services.Lead"]</p>
            </header>
            <ul class="svc-list" role="list">
                @foreach (var service in services)
                {
                    @* pillar--* gives each row its own accent colour. Presentation only. *@
                    <li class="svc pillar pillar--@service.Key.ToLowerInvariant()" data-reveal>
                        <span class="svc__icon" aria-hidden="true"><partial name="_Icon" model="service.Icon" /></span>
                        <span class="svc__body">
                            <h3 class="svc__title">
                                @if (service.Path is not null)
                                {
                                    <a class="svc__link" href="@service.Path">@Copy[$"Home.Service.{service.Key}.Title"]</a>
                                }
                                else
                                {
                                    @Copy[$"Home.Service.{service.Key}.Title"]
                                }
                            </h3>
                            <span class="svc__text">@Copy[$"Home.Service.{service.Key}.Text"]</span>
                            @if (service.Path is null)
                            {
                                <span class="svc__pending">@T["Home.Service.Pending"]</span>
                            }
                        </span>
                        @if (service.Path is not null)
                        {
                            <span class="svc__arrow" aria-hidden="true"></span>
                        }
                    </li>
                }
            </ul>
            <a class="button button--secondary button--small button--arrow services__all" href="@links.Services"><span>@Copy["Public.Mega.All"]</span></a>
        </div>

        <aside class="newsagent" aria-labelledby="newsagent-title" data-reveal>
            <header class="newsagent__head">
                <span class="newsagent__avatar" aria-hidden="true">
                    <svg viewBox="0 0 64 64" focusable="false">
                        <circle class="newsagent__ring" cx="32" cy="32" r="29" />
                        <circle class="newsagent__ring newsagent__ring--2" cx="32" cy="32" r="29" />
                        <circle cx="32" cy="34" r="22" fill="var(--sky-soft)" />
                        <line x1="32" y1="12" x2="32" y2="17" stroke="var(--sky-3)" stroke-width="2.2" stroke-linecap="round" />
                        <circle class="newsagent__antenna" cx="32" cy="11" r="2.8" fill="var(--sky)" />
                        <rect x="18" y="17" width="28" height="22" rx="7" fill="#fff" stroke="var(--sky-3)" stroke-width="2.2" />
                        <rect x="22" y="22" width="20" height="11" rx="4" fill="var(--sky-soft)" />
                        <g class="newsagent__eyes"><circle cx="28" cy="27.5" r="2.2" fill="var(--sky-3)" /><circle cx="36" cy="27.5" r="2.2" fill="var(--sky-3)" /></g>
                        <rect x="23" y="42" width="18" height="10" rx="3" fill="#fff" stroke="var(--sky-3)" stroke-width="2" />
                        <path d="M27 49v-2M30.5 49v-4M34 49v-3M37.5 49v-5" stroke="var(--sky-3)" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>
                <div class="newsagent__titles">
                    <p class="label">@Copy["Home.NewsAgent.Eyebrow"]</p>
                    <h2 id="newsagent-title" class="newsagent__title">@Copy["Home.NewsAgent.Title"]</h2>
                </div>
                <span class="newsagent__status"><i aria-hidden="true"></i>@Copy["Home.NewsAgent.Status"]</span>
            </header>
            <p class="newsagent__lead">@Copy["Home.NewsAgent.Lead"]</p>

            @if (Model.LatestNews.Count > 0)
            {
                <ol class="newsagent__feed" role="list">
                    @foreach (var item in Model.LatestNews)
                    {
                        var date = item.SourcePublishedAtUtc ?? item.PublishedAtUtc;
                        <li class="newsagent__item">
                            <div class="newsagent__meta">
                                @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                {
                                    <span class="newsagent__chip">@item.CategoryName</span>
                                }
                                <time datetime="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" dir="ltr">@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</time>
                            </div>
                            <h3 class="newsagent__headline"><a href="@SitePaths.Encode(item.Path)">@item.Title</a></h3>
                            <p class="newsagent__summary">@item.Summary</p>
                            <p class="newsagent__source">@string.Format(CultureInfo.InvariantCulture, T["News.ReportedBy"].Value, item.Publisher)</p>
                        </li>
                    }
                </ol>
            }
            else
            {
                @* Nothing published yet: an honest waiting state, never placeholder headlines. *@
                <div class="newsagent__empty">
                    <div class="newsagent__scan" aria-hidden="true"><span></span><span></span><span></span></div>
                    <p>@Copy["Home.NewsAgent.Empty"]</p>
                </div>
            }

            @if (Model.NewsHubPath is not null)
            {
                <a class="newsagent__all link-arrow" href="@Model.NewsHubPath">@T["News.All"]</a>
            }
        </aside>
    </div>
</section>

@* AaaS Ecosystem (visual service diagram) — fixed section, always visible. *@
<partial name="_AaaSEcosystem" />

@* SaaS products — ready-to-use systems, each shown with its confirmed purpose only. *@
<partial name="_SaasProducts" />

@{
    async Task RenderProcess()
    {
        @* D. How we work *@
        <section class="section surface-2 process" aria-labelledby="process-title">
            <div class="container">
                <header class="section-head" data-reveal>
                    <div class="section-head__main">
                        <p class="label">@Copy["Home.Process.Eyebrow"]</p>
                        <h2 id="process-title" class="heading-xl">@Copy["Home.Process.Title"]</h2>
                    </div>
                    <p class="section-head__lead">@Copy["Home.Process.Lead"]</p>
                </header>
                <ol class="process__steps" role="list">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <li class="process__step" data-reveal>
                            <span class="process__dot" aria-hidden="true"></span>
                            <span class="process__number" dir="ltr">@i.ToString("00", CultureInfo.InvariantCulture)</span>
                            <h3 class="process__title">@Copy[$"Home.Process.Step{i}.Title"]</h3>
                            <p class="process__text">@Copy[$"Home.Process.Step{i}.Text"]</p>
                        </li>
                    }
                </ol>
                @if (links.Page("how-we-work") is { } howWeWork)
                {
                    <p class="section-more"><a class="link-arrow" href="@howWeWork">@Copy["Home.Process.More"]</a></p>
                }
            </div>
        </section>
    }

    async Task RenderWhy()
    {
        @* E. Why ONYX *@
        <section id="why-onyx" class="why" aria-labelledby="why-title">
            <div class="why__visual" aria-hidden="true">
                @if (whyImage is not null)
                {
                    <img src="@whyImage" width="1000" height="1200" alt="" loading="lazy" decoding="async">
                }
                else
                {
                    <img src="~/images/onyx-facets.webp" asp-append-version="true" width="1000" height="1200" alt="" loading="lazy" decoding="async">
                }
            </div>
            <div class="why__content" data-reveal>
                <p class="label">@Copy["Home.Why.Eyebrow"]</p>
                <h2 id="why-title" class="heading-xl">@Copy["Home.Why.Title"]</h2>
                <p class="lead">@Copy["Home.Why.Lead"]</p>
                @if (links.Page("about") is { } about)
                {
                    <a class="link-arrow" href="@about">@Copy["Home.Why.More"]</a>
                }
                <ul class="why__points" role="list">
                    @foreach (var (key, icon) in why)
                    {
                        <li class="why__point">
                            <partial name="_Icon" model="icon" />
                            <h3 class="why__point-title">@Copy[$"Home.Why.{key}.Title"]</h3>
                            <p class="why__point-text">@Copy[$"Home.Why.{key}.Text"]</p>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    async Task RenderWork()
    {
        workRendered = true;
        if (Model.FeaturedWork.Count == 0)
        {
            return;
        }

        <section class="section work" aria-labelledby="featured-work-heading">
            <div class="container">
                <header class="section-head" data-reveal>
                    <div class="section-head__main">
                        <p class="label">@Copy["Home.FeaturedWork"]</p>
                        <h2 id="featured-work-heading" class="heading-xl">@Copy["Home.Work.Title"]</h2>
                    </div>
                    @if (links.Work is not null)
                    {
                        <a class="button button--secondary button--small button--arrow section-head__action" href="@links.Work"><span>@Copy["Home.Work.All"]</span></a>
                    }
                </header>
                <ul class="card-grid" role="list">
                    @foreach (var item in Model.FeaturedWork)
                    {
                        <li class="card" data-reveal>
                            <h3 class="card__title"><a class="card__link" href="@SitePaths.Encode(item.Path)">@item.Title</a></h3>
                            @if (!string.IsNullOrEmpty(item.Summary))
                            {
                                <p class="card__text">@item.Summary</p>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    async Task RenderStack()
    {
        @* F. Technology stack *@
        <section class="section surface-3 stack" aria-labelledby="stack-title">
            <div class="container stack__grid">
                <div class="stack__intro" data-reveal>
                    <p class="label">@Copy["Home.Stack.Eyebrow"]</p>
                    <h2 id="stack-title" class="heading-xl">@Copy["Home.Stack.Title"]</h2>
                    <p class="lead">@Copy["Home.Stack.Lead"]</p>
                    <p class="note">@Copy["Home.Stack.Note"]</p>
                    @if (links.Page("technologies") is { } technologies)
                    {
                        <a class="link-arrow" href="@technologies">@Copy["Home.Stack.More"]</a>
                    }
                </div>
                <div class="stack__groups">
                    @foreach (var group in stack)
                    {
                        <div class="stack__group" data-reveal>
                            <h3 class="stack__title">@Copy[$"Home.Stack.{group}.Title"]</h3>
                            <ul class="stack__list" role="list">
                                @foreach (var item in Items($"Home.Stack.{group}.Items"))
                                {
                                    <li dir="auto">@item</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    async Task RenderSecurity()
    {
        @* G. Security & reliability *@
        <section class="section surface-warm security" aria-labelledby="security-title">
            <div class="container security__grid">
                <div class="security__intro" data-reveal>
                    <p class="label">@Copy["Home.Security.Eyebrow"]</p>
                    <h2 id="security-title" class="heading-xl">@Copy["Home.Security.Title"]</h2>
                    <p class="lead">@Copy["Home.Security.Lead"]</p>
                    <p class="note">@Copy["Home.Security.Note"]</p>
                    @if (links.Page("services.security") is { } securityPage)
                    {
                        <a class="link-arrow" href="@securityPage">@Copy["Home.Security.More"]</a>
                    }
                </div>
                <ul class="security__list" role="list">
                    @foreach (var (key, icon) in security)
                    {
                        <li class="security__item" data-reveal>
                            <partial name="_Icon" model="icon" />
                            <h3 class="security__title">@Copy[$"Home.Security.{key}.Title"]</h3>
                            <p class="security__text">@Copy[$"Home.Security.{key}.Text"]</p>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    // Editors may hide or reorder these sections (Admin → Homepage); featured work, when there is any, follows "Why ONYX".
    foreach (var section in Copy.HomeSectionOrder())
    {
        if (!Copy.IsHomeSectionVisible(section))
        {
            continue;
        }

        switch (section)
        {
            case "process": await RenderProcess(); break;
            case "why": await RenderWhy(); await RenderWork(); break;
            case "stack": await RenderStack(); break;
            case "security": await RenderSecurity(); break;
        }
    }

    if (!workRendered)
    {
        await RenderWork();
    }
}

@* H. Insights (published CMS insights only; hidden when there are none) ----------------------------------------------------- *@
@if (Model.LatestInsights.Count > 0)
{
    <section class="section surface-2 insights" aria-labelledby="insights-title">
        <div class="container insights__grid">
            <header class="insights__intro" data-reveal>
                <p class="label">@Copy["Home.Insights.Eyebrow"]</p>
                <h2 id="insights-title" class="heading-xl">@Copy["Home.Insights.Title"]</h2>
                <p class="lead">@Copy["Home.Insights.Lead"]</p>
                @if (links.Insights is not null)
                {
                    <a class="button button--secondary button--small button--arrow" href="@links.Insights"><span>@Copy["Home.Insights.All"]</span></a>
                }
            </header>
            <ul class="card-grid card-grid--three" role="list">
                @foreach (var item in Model.LatestInsights)
                {
                    <li class="card card--article" data-reveal>
                        @if (item.FeaturedImage is { } image)
                        {
                            <img class="card__media" src="/media/@image.Id.ToString("D")" alt="@(image.Alt ?? string.Empty)" width="@image.Width" height="@image.Height" loading="lazy" decoding="async">
                        }
                        <div class="card__body">
                            @if (item.PublishedAtUtc is { } published)
                            {
                                <time class="card__meta" datetime="@published.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" dir="ltr">@published.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</time>
                            }
                            <h3 class="card__title"><a class="card__link" href="@SitePaths.Encode(item.Path)">@item.Title</a></h3>
                            @if (!string.IsNullOrEmpty(item.Summary))
                            {
                                <p class="card__text">@item.Summary</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@* Latest news now lives in the monitoring agent panel beside the services (section C). *@

@* I. Final CTA ---------------------------------------------------------------------------------------------------------------- *@
@if (Copy.IsHomeSectionVisible("cta"))
{
    <section class="cta" aria-labelledby="cta-title">
        <div class="cta__visual" aria-hidden="true">
            <img src="~/images/onyx-stone.webp" asp-append-version="true" width="1000" height="1000" alt="" loading="lazy" decoding="async">
        </div>
        <div class="container cta__inner" data-reveal>
            <h2 id="cta-title" class="heading-xl">@Copy["Home.Cta.Title"]</h2>
            <p class="lead">@Copy["Home.Cta.Text"]</p>
            <div class="cta__actions">
                @if (links.Contact is not null)
                {
                    <a class="button button--primary button--arrow" href="@links.Contact"><span>@Copy["Public.Cta.Talk"]</span></a>
                }
                <a class="button button--secondary" href="@links.Services"><span>@Copy["Home.Cta.Services"]</span></a>
            </div>
        </div>
    </section>
}
