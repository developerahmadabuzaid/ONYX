@model Onyx.Web.Content.HomePageModel
@* Shell only: visual design follows design approval. Sections without verified content are not rendered. *@
<h1>@T["Site.Name"]</h1>
@if (Model.FeaturedWork.Count > 0)
{
    <section aria-labelledby="featured-work-heading">
        <h2 id="featured-work-heading">@T["Home.FeaturedWork"]</h2>
        <partial name="_ListingItems" model="Model.FeaturedWork" />
    </section>
}
@if (Model.LatestNews.Count > 0)
{
    <section aria-labelledby="latest-news-heading">
        <h2 id="latest-news-heading">@T["Home.LatestNews"]</h2>
        <partial name="_NewsItems" model="Model.LatestNews" />
        @if (Model.NewsHubPath is not null)
        {
            <p><a href="@Model.NewsHubPath">@T["News.All"]</a></p>
        }
    </section>
}
