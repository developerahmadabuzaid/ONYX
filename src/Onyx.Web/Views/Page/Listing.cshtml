@model Onyx.Web.Content.SectionListingViewModel
@inject LocalizedRouteTable Routes
@inject Onyx.Web.Content.SitePages.SitePageCatalog SitePages
@{
    var path = Onyx.Web.Content.SectionRoutes.PathOf(Model.Section, Model.LanguageCode)!;
    var items = Model.Items;
    ViewData["Nav"] = Model.Section.Split('/')[0];
    var links = Onyx.Web.Content.SiteLinks.For(Routes, SitePages, Model.LanguageCode);
}
<header class="listing-header">
    <h1 class="page-title">@T["Section." + Model.Section]</h1>
</header>
@if (items.Items.Count == 0)
{
    @* Honest empty state: nothing is invented to fill the listing. *@
    <div class="empty-state">
        <p>@T["Section.Empty"]</p>
        <p>@T["Section.EmptyHint"]</p>
        <div class="empty-state__links">
            <a class="button button--secondary button--small button--arrow" href="@links.Services"><span>@T["Public.Mega.All"]</span></a>
            @if (links.Contact is not null)
            {
                <a class="button button--secondary button--small" href="@links.Contact"><span>@T["Public.Nav.Contact"]</span></a>
            }
        </div>
    </div>
}
else
{
    <partial name="_ListingItems" model="items.Items" />
    @if (items.TotalPages > 1)
    {
        <nav class="pager" aria-label="@T["Section.Pages"]" dir="ltr">
            @if (items.Page > 1)
            {
                <a href="@(SitePaths.Encode(path) + (items.Page > 2 ? $"?page={items.Page - 1}" : string.Empty))" rel="prev">@(items.Page - 1)</a>
            }
            <span class="pager__status">@items.Page / @items.TotalPages</span>
            @if (items.Page < items.TotalPages)
            {
                <a href="@(SitePaths.Encode(path))?page=@(items.Page + 1)" rel="next">@(items.Page + 1)</a>
            }
        </nav>
    }
}
