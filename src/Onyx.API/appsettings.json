{
  "ConnectionStrings": {
    "Onyx": ""
  },
  "AllowedHosts": "localhost",
  "ApiSecurity": {
    "MaxRequestBodySizeBytes": 1048576,
    "HstsMaxAgeDays": 365
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Strict": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Jwt": {
    "Issuer": "onyx-api",
    "Audience": "onyx-web",
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "Sessions": {
    "IdleTimeoutMinutes": 60,
    "AbsoluteLifetimeHours": 12,
    "RefreshGraceSeconds": 30,
    "MaxGraceRedemptions": 3,
    "TwoFactorChallengeMinutes": 5,
    "EnrollmentChallengeMinutes": 15,
    "MaxChallengeAttempts": 5,
    "ValidationCacheSeconds": 15,
    "PermissionCacheSeconds": 60
  },
  "Content": {
    "PreviewTokenMinutes": 30,
    "SchedulerBatchSize": 50
  },
  "Media": {
    "StorageRoot": "",
    "MaxUploadBytes": 10485760,
    "MaxWidth": 8000,
    "MaxHeight": 8000,
    "MaxPixels": 40000000
  },
  "IdentitySecurity": {
    "RequireTwoFactorForAllUsers": false,
    "AdminPortalBaseUrl": "",
    "InvitationLifetimeHours": 72,
    "PasswordResetLifetimeMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
