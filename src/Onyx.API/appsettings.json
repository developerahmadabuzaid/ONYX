{
  "ConnectionStrings": {
    "Onyx": ""
  },
  "AllowedHosts": "localhost",
  "ApiSecurity": {
    "MaxRequestBodySizeBytes": 1048576,
    "HstsMaxAgeDays": 365
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Strict": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
